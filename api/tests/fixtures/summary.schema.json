{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "themes",
    "suggestedActions"
  ],
  "properties": {
    "mode": {
      "const": "mock"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theme",
          "label",
          "noteIds"
        ],
        "properties": {
          "theme": {
            "enum": [
              "scope",
              "planning",
              "review",
              "ci",
              "quality",
              "collaboration",
              "dependencies"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "noteIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,40}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "suggestedActions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,40}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
